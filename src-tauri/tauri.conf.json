{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostrank",
  "version": "0.0.0",
  "identifier": "com.ghostrank.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ghostrank",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:ghostrank.db"
      ]
    }
  }
}
